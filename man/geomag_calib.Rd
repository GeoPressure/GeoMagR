\deqn{\mathbf{M}_i = \mathbf{R}^\top \mathbf{A}^{-1} \mathbf{R} (\mathbf{B}_i - \mathbf{o}),
\qquad a_1 a_2 a_3 = 1.}{M_i = t(R) A^-1 R (B_i - o), with a1 a2 a3 = 1.}
